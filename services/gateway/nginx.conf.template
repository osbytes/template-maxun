server {
    listen __LISTEN_PORT__;
    server_name _;

    client_max_body_size 100m;

    # Runtime DNS so nginx can start before private upstreams are ready.
    resolver __RESOLVER__ valid=10s ipv6=on;
    resolver_timeout 5s;

    # Backend API + auth (must share the browser origin with the UI so the
    # httpOnly JWT cookie is same-site).
    location ~ ^/(auth|api|storage|record|workflow|proxy|webhook|api-docs)(/|$) {
        set $backend_upstream __BACKEND_UPSTREAM__;
        proxy_pass http://$backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 300s;
    }

    # Socket.IO (recording / run events)
    location /socket.io/ {
        set $backend_upstream __BACKEND_UPSTREAM__;
        proxy_pass http://$backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok";
    }

    # Static UI + SPA routes
    location / {
        set $frontend_upstream __FRONTEND_UPSTREAM__;
        proxy_pass http://$frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
